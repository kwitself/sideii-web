# Public app / Supabase
NEXT_PUBLIC_SITE_URL=https://sideii-web.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key — NEVER prefix with NEXT_PUBLIC_
# Preferred modern name:
SUPABASE_SECRET_KEY=
# Legacy projects may instead use:
# SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend)
RESEND_API_KEY=
SIDEII_ORDER_FROM=SIDE:II Store <orders@example.com>
SIDEII_APPLICATION_FROM=SIDE:II Applications <applications@example.com>

# Provider-dependent production integrations
# Add only after the actual provider is selected and webhook routes are implemented.
# PAYMENT_PROVIDER=
# PAYMENT_PUBLIC_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
# CARRIER_PROVIDER=
# CARRIER_API_KEY=
# FX_PROVIDER=
# FX_API_KEY=
